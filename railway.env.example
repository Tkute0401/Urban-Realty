# Railway Environment Variables
# Copy these to your Railway project's Variables tab

# Required Variables
NODE_ENV=production
MONGODB_URI=your_mongodb_connection_string_here
JWT_SECRET=your_secure_jwt_secret_minimum_32_characters_long

# Optional Variables
PORT=3000
HOSTNAME=0.0.0.0
FRONTEND_URL=https://urban-realty-production.up.railway.app
CORS_ORIGIN=https://urban-realty-production.up.railway.app,http://localhost:3000

# Next.js Configuration
NEXT_TELEMETRY_DISABLED=1
DISABLE_ESLINT_PLUGIN=true
SKIP_ENV_VALIDATION=true

# PM2 Configuration (if using PM2)
PM2_PUBLIC_KEY=
PM2_SECRET_KEY=
PM2_MACHINE_NAME=urban-realty-nextjs-production

# Optional Service Variables
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (Optional)
EMAIL_FROM=noreply@urbanrealty.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# MapTiles (Optional)
MAPPLS_API_KEY=your_mappls_api_key

# Sentry (Optional)
SENTRY_DSN=your_sentry_dsn