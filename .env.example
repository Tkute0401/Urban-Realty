# Global
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/urban_realty

# JWT
JWT_SECRET=change-me-to-a-32-char-secret-min
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email
EMAIL_FROM=hello@example.com
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your-user
EMAIL_PASS=your-pass

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info

# Redis (optional)
REDIS_URL=

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=change-me-to-a-32-char-secret-min

# API Keys (optional)
GOOGLE_MAPS_API_KEY=

# Monitoring (optional)
SENTRY_DSN=
