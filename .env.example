NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/urban_realty

# JWT
JWT_SECRET=change_me_to_a_very_long_random_string
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Email (SMTP)
EMAIL_FROM=dev@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=username
EMAIL_PASS=password

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info

# Redis (optional)
REDIS_URL=

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=change_me_to_another_long_random_string

# API Keys (optional)
GOOGLE_MAPS_API_KEY=

# Monitoring (optional)
SENTRY_DSN=
# Urban Realty Environment Configuration

# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGO_URI=mongodb://localhost:27017/urban-realty

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRE=30d
