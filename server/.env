# Backend Environment Configuration - DEVELOPMENT ONLY
NODE_ENV=development
PORT=3001

# Database Configuration - Using PostgreSQL for development  
DATABASE_URL=${DATABASE_URL}
MONGODB_URI=mongodb+srv://demo:demo@cluster0.abcde.mongodb.net/urban-realty-dev?retryWrites=true&w=majority

# JWT Configuration - REPLACE WITH SECURE VALUES
JWT_SECRET=your-super-secret-jwt-key-must-be-at-least-32-characters-long
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# CORS Configuration
CORS_ORIGIN=http://localhost:5000

# Frontend URL  
FRONTEND_URL=http://localhost:5000

# PLACEHOLDER - Add your own API keys
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=10485760

# Logging
LOG_LEVEL=info