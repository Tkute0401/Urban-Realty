{
  "name": "Squarefooot - Premier Real Estate Platform",
  "short_name": "Squarefooot",
  "description": "Find your dream property with Squarefooot. Browse thousands of homes, apartments, and commercial properties with expert agents and seamless transactions.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#1976d2",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "en-US",
  "dir": "ltr",
  "categories": ["business", "lifestyle", "shopping"],
  "screenshots": [
    {
      "src": "/images/screenshots/desktop-homepage.png",
      "sizes": "1280x720",
      "type": "image/png",
      "platform": "wide",
      "label": "Squarefooot Homepage"
    },
    {
      "src": "/images/screenshots/mobile-property-listing.png",
      "sizes": "390x844",
      "type": "image/png",
      "platform": "narrow",
      "label": "Property Listings"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "maskable any"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable any"
    }
  ],
  "shortcuts": [
    {
      "name": "Search Properties",
      "short_name": "Search",
      "description": "Search for properties to buy or rent",
      "url": "/properties?intent=search",
      "icons": [
        {
          "src": "/icons/search-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Featured Properties",
      "short_name": "Featured",
      "description": "View featured property listings",
      "url": "/properties?featured=true",
      "icons": [
        {
          "src": "/icons/featured-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Saved Properties",
      "short_name": "Saved",
      "description": "Access your saved properties",
      "url": "/user/favorites",
      "icons": [
        {
          "src": "/icons/favorites-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "EMI Calculator",
      "short_name": "EMI Calc",
      "description": "Calculate home loan EMI",
      "url": "/emi-calculator",
      "icons": [
        {
          "src": "/icons/calculator-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-property",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+urbanrealty",
      "url": "/property/%s"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.urbanrealty.app",
      "id": "com.urbanrealty.app"
    },
    {
      "platform": "itunes",
      "url": "https://apps.apple.com/app/urban-realty/id123456789"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": ["navigate-existing", "navigate-new"]
  },
  "handle_links": "preferred",
  "file_handlers": [
    {
      "action": "/import-property",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ]
}